#include <iostream>


using namespace std;


char getGrade_displayPrompt(bool loop = true) {
    char grade;
    char grades[] = {'A', 'B', 'C', 'D', 'F', 'X'};
    cout << "Please enter grade (A, B, C, D or F, X to finish): ";
    while (loop) {
        cin >> grade;
        for (int i = 0; i != 5; i++) {
            if (grade == grades[i]) {
                return grade;
            }
        }
        cout << "Invalid grade, please enter grade (A, B, C, D or F, X to finish): ";
    }
}



